{
  "private": true,
  "name": "hrms",
  "description": "Open Source HR & Payroll System powered by the Frappe Framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frappe/hrms.git"
  },
  "homepage": "https://frappe.io/hr",
  "author": "Frappe Technologies Pvt. Ltd.",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/frappe/hrms/issues"
  },
  "aworkspaces": ["frontend", "roster", "frappe-ui"],
  "scripts": {
    "postinstall": "npm run install-modern-backend && npm run install-modern-frontend",
    "install-modern-backend": "npm --prefix modern-stack/backend install --legacy-peer-deps",
    "install-modern-frontend": "npm --prefix modern-stack/frontend install --legacy-peer-deps",
    "dev:backend": "cd modern-stack/backend && npm run dev",
    "dev:frontend": "cd modern-stack/frontend && npm run dev",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev-pwa": "cd frontend && yarn dev",
    "dev-roster": "cd roster && yarn dev",
    "build": "yarn build-pwa && yarn build-roster",
    "build-pwa": "cd frontend && yarn build",
    "build-roster": "cd roster && yarn build"
  },
  "dependencies": {
    "concurrently": "^9.0.1",
    "html2canvas": "^1.4.1"
  }
}
